      "parameters": {
        "jsCode": "const data = items[0].json.body?.data?.fields || [];\n\nconst result = {};\n\nfor (const field of data) {\n  const label = field.label;\n\n  if (label === \"First name\") result.firstName = field.value;\n  if (label === \"Last name\") result.lastName = field.value;\n  if (label === \"Email\") result.email = field.value;\n\n  if (label === \"What service are you interested in?\") {\n    const selectedId = field.value?.[0];\n    const option = field.options?.find(o => o.id === selectedId);\n    result.service = option ? option.text : \"\";\n  }\n\n  if (label === \"Budget\") {\n    const selectedId = field.value?.[0];\n    const option = field.options?.find(o => o.id === selectedId);\n    result.budget = option ? option.text : \"\";\n  }\n\n  if (label === \"When do you want to start?\") {\n    const selectedId = field.value?.[0];\n    const option = field.options?.find(o => o.id === selectedId);\n    result.timeline = option ? option.text : \"\";\n  }\n\n  if (label === \"Description\") result.description = field.value;\n}\n\nreturn [{ json: result }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
