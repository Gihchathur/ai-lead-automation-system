              "message": "You are a sales assistant helping qualify inbound leads for a freelance automation business. Analyze the lead and return ONLY valid JSON. Do not include any extra text outside JSON."
            },
            {
              "type": "HumanMessagePromptTemplate",
              "message": "=Lead data: First name: {{$json.firstName}} Last name: {{$json.lastName}} Email: {{$json.email}} Service: {{$json.service}} Budget: {{$json.budget}} Timeline: {{$json.timeline}} Description: {{$json.description}} Instructions: - Evaluate lead quality as High, Medium, or Low - Evaluate priority as High, Medium, or Low - Determine intent as Serious, Exploring, or Unclear - Provide a short summary of the lead - Suggest the best next action - Suggest the best reply tone Return ONLY this JSON format: { \"leadQuality\": \"\", \"priority\": \"\", \"intent\": \"\", \"summary\": \"\", \"recommendedAction\": \"\", \"replyTone\": \"\" }"
            }
          ]
        },
